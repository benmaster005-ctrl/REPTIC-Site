# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (utilisée pour le sitemap, les métadonnées et les e-mails d'auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des e-mails du site par SMTP : le même fournisseur que dans Supabase
# (Authentication > SMTP Settings). Sans SMTP_HOST, aucun e-mail n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
# "true" pour SSL (port 465) ; par défaut déduit du port
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur (adresse autorisée par le fournisseur SMTP)
EMAIL_FROM="REPTIC.CM <noreply@reptic.cm>"
# Adresse de réponse et destinataire des alertes internes (par défaut : e-mail de contact du site)
EMAIL_REPLY_TO=
EMAIL_NOTIFY_TO=
