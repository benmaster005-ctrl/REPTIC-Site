# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (utilisée pour le sitemap, les métadonnées et les e-mails d'auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des e-mails du site (https://resend.com) : sans clé, aucun e-mail n'est envoyé
RESEND_API_KEY=
# Expéditeur (domaine vérifié chez Resend)
EMAIL_FROM="REPTIC.CM <noreply@reptic.cm>"
# Adresse de réponse et destinataire des alertes internes (par défaut : e-mail de contact du site)
EMAIL_REPLY_TO=
EMAIL_NOTIFY_TO=
